# Salin jadi .env untuk menjalankan di komputer sendiri (jangan di-commit).

# Connection string dari Neon (Dashboard > Connect), contoh:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Rahasia untuk token login admin. Isi teks acak panjang.
JWT_SECRET=ganti-dengan-teks-acak-panjang

# Akun admin (password minimal 8 karakter)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat

# Domain frontend Vercel, pisahkan dengan koma jika lebih dari satu. Kosong = izinkan semua.
CORS_ORIGIN=https://kamart.vercel.app

# Isi data awal dari KAmart_Pencatatan saat database masih kosong
AUTO_SEED=true

# Web Push (notifikasi HP admin walau aplikasi ditutup).
# Buat sekali dengan: cd backend && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scurebot.site

# Foto produk di Neon Object Storage (bucket). Kosongkan untuk menyimpan foto di database.
# Console Neon > project > branch > Object storage: buat bucket dengan akses "public_read",
# lalu buat credential (storage:read + storage:write).
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_BUCKET=kamart-produk
# Opsional: alamat publik bucket jika berbeda dari AWS_ENDPOINT_URL_S3/NEON_BUCKET
NEON_BUCKET_PUBLIC_URL=

PORT=3000
