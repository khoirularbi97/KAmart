{
  "name": "kamart-api",
  "version": "1.0.0",
  "private": true,
  "description": "API toko kelontong KAmart (Express + PostgreSQL/Neon)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "vapid": "web-push generate-vapid-keys"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "web-push": "3.6.7"
  }
}
